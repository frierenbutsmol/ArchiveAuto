{
  "expo": {
    "name": "ArchiveAuto",
    "slug": "ArchiveAuto",
    "version": "1.0.0",
    "scheme": "archiveauto",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jeppotea.ArchiveAuto"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "ArchiveAuto uses the camera so you can photograph receipts and vehicle documents.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0d382214-dcd5-490d-810f-db53b178029c"
      }
    },
    "owner": "jeppotea",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0d382214-dcd5-490d-810f-db53b178029c"
    }
  }
}